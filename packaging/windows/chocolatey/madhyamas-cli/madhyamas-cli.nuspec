<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>madhyamas-cli</id>
    <version>0.1.0</version>
    <title>Madhyamas CLI</title>
    <authors>Madhyamas Team</authors>
    <owners>madhyamas</owners>
    <projectUrl>https://github.com/madhyamas/madhyamas</projectUrl>
    <licenseUrl>https://github.com/madhyamas/madhyamas/blob/main/LICENSE-MIT</licenseUrl>
    <iconUrl>https://raw.githubusercontent.com/madhyamas/madhyamas/main/assets/icon.png</iconUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Command-line interface for Madhyamas debugging proxy. Interact with Madhyamas server, manage traffic, sessions, and configuration from the terminal.</description>
    <summary>CLI tool for Madhyamas proxy server</summary>
    <releaseNotes>https://github.com/madhyamas/madhyamas/releases</releaseNotes>
    <tags>proxy cli http https debugging developer-tools</tags>
    <packageSourceUrl>https://github.com/madhyamas/madhyamas/tree/main/packaging/windows/chocolatey/madhyamas-cli</packageSourceUrl>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
