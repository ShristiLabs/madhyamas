<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>madhyamas-mcp</id>
    <version>0.1.0</version>
    <title>Madhyamas MCP Server</title>
    <authors>Madhyamas Team</authors>
    <owners>madhyamas</owners>
    <projectUrl>https://github.com/madhyamas/madhyamas</projectUrl>
    <licenseUrl>https://github.com/madhyamas/madhyamas/blob/main/LICENSE-MIT</licenseUrl>
    <iconUrl>https://raw.githubusercontent.com/madhyamas/madhyamas/main/assets/icon.png</iconUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Model Context Protocol (MCP) server for Madhyamas. Enables AI agents like Claude, Cursor, and Windsurf to interact with Madhyamas for automated debugging and traffic analysis.</description>
    <summary>MCP server for AI agent integration with Madhyamas</summary>
    <releaseNotes>https://github.com/madhyamas/madhyamas/releases</releaseNotes>
    <tags>proxy mcp ai-agent claude cursor windsurf debugging</tags>
    <packageSourceUrl>https://github.com/madhyamas/madhyamas/tree/main/packaging/windows/chocolatey/madhyamas-mcp</packageSourceUrl>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
