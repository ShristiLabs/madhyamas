<?xml version="1.0" encoding="UTF-8"?>
<!--
  Madhyamas MSI Installer
  Build with: wix build madhyamas.wxs -acceptEula wix7 -o madhyamas.msi

  Single unified binary: proxy server + web UI (embedded) + MCP server + CLI.
  No external web assets needed — everything is embedded via rust-embed.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Madhyamas"
           Manufacturer="Madhyamas Team"
           Version="0.1.0"
           UpgradeCode="E8F5C3A2-1B4D-4E6F-8A9C-0D2E3F4A5B6C"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Madhyamas is already installed." />

    <Media Id="1" Cabinet="madhyamas.cab" EmbedCab="yes" />

    <Feature Id="MainFeature" Title="Madhyamas" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <!-- Add to PATH -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <UI>
      <UIRef Id="WixUI_Minimal" />
    </UI>

    <!-- Use built-in WiX UI assets (no custom banner/dialog needed) -->

  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Madhyamas">
        <Directory Id="BinFolder" Name="bin" />
      </Directory>
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="BinFolder">
      <Component Id="MadhyamasExe" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
        <File Id="madhyamas.exe" Source="$(var.SourceDir)\bin\madhyamas.exe" KeyPath="yes" />
        <Environment Id="PATH" Name="PATH" Value="[BinFolder]" Permanent="no" Part="last" Action="set" System="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

</Wix>
