# AUR Package for ProxyForge
# Maintainer: ProxyForge Team <team@proxyforge.io>

pkgname=proxyforge
pkgver=0.1.0
pkgrel=1
pkgdesc="Open-source HTTP/HTTPS debugging proxy with web-based UI"
arch=('x86_64' 'aarch64')
url="https://github.com/proxyforge/proxyforge"
license=('MIT' 'Apache-2.0')
depends=('openssl' 'gcc-libs' 'glibc')
makedepends=('rust' 'cargo' 'nodejs' 'npm')
optdepends=(
    'firefox: Browser for web UI'
    'chromium: Browser for web UI'
)
backup=('etc/proxyforge/config.toml')
install=proxyforge.install

source=(
    "https://github.com/proxyforge/proxyforge/archive/refs/tags/v${pkgver}.tar.gz"
    "proxyforge.service"
    "proxyforge.sysusers"
    "proxyforge.tmpfiles"
)

sha256sums=('PLACEHOLDER_SHA256'
            'SKIP'
            'SKIP'
            'SKIP')

build() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    # Build backend
    cargo build --release -p proxyforge-cli

    # Build frontend
    cd web
    npm install
    npm run build
}

package() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    # Install binary
    install -Dm755 "target/release/proxyforge-cli" "${pkgdir}/usr/bin/proxyforge"

    # Install web assets
    install -dm755 "${pkgdir}/usr/share/proxyforge/web"
    cp -r web/dist/* "${pkgdir}/usr/share/proxyforge/web/"

    # Install systemd service
    install -Dm644 "${srcdir}/proxyforge.service" "${pkgdir}/usr/lib/systemd/system/proxyforge.service"

    # Install sysusers config
    install -Dm644 "${srcdir}/proxyforge.sysusers" "${pkgdir}/usr/lib/sysusers.d/proxyforge.conf"

    # Install tmpfiles config
    install -Dm644 "${srcdir}/proxyforge.tmpfiles" "${pkgdir}/usr/lib/tmpfiles.d/proxyforge.conf"

    # Install default config
    install -Dm644 "config/default.toml" "${pkgdir}/etc/proxyforge/config.toml"

    # Install licenses
    install -Dm644 "LICENSE-MIT" "${pkgdir}/usr/share/licenses/${pkgname}/MIT"
    install -Dm644 "LICENSE-APACHE" "${pkgdir}/usr/share/licenses/${pkgname}/Apache-2.0"

    # Install shell completions
    install -dm755 "${pkgdir}/usr/share/bash-completion/completions"
    install -dm755 "${pkgdir}/usr/share/zsh/site-functions"
    install -dm755 "${pkgdir}/usr/share/fish/vendor_completions.d"

    "${pkgdir}/usr/bin/proxyforge" completion --shell bash > "${pkgdir}/usr/share/bash-completion/completions/proxyforge"
    "${pkgdir}/usr/bin/proxyforge" completion --shell zsh > "${pkgdir}/usr/share/zsh/site-functions/_proxyforge"
    "${pkgdir}/usr/bin/proxyforge" completion --shell fish > "${pkgdir}/usr/share/fish/vendor_completions.d/proxyforge.fish"
}
