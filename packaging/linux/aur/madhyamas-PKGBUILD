# AUR Package for Madhyamas
# Maintainer: Madhyamas Team <team@madhyamas.io>

pkgname=madhyamas
pkgver=0.1.0
pkgrel=1
pkgdesc="Open-source HTTP/HTTPS debugging proxy with web-based UI"
arch=('x86_64' 'aarch64')
url="https://github.com/madhyamas/madhyamas"
license=('MIT' 'Apache-2.0')
depends=('openssl' 'gcc-libs' 'glibc')
makedepends=('rust' 'cargo' 'nodejs' 'npm')
optdepends=(
    'firefox: Browser for web UI'
    'chromium: Browser for web UI'
)
backup=('etc/madhyamas/config.toml')
source=(
    "https://github.com/madhyamas/madhyamas/archive/refs/tags/v${pkgver}.tar.gz"
    "madhyamas.service"
)
sha256sums=('SKIP' 'SKIP')

build() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    # Build backend
    cargo build --release -p madhyamas-cli

    # Build frontend
    cd web
    npm ci
    npm run build
}

package() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    # Install binary
    install -Dm755 "target/release/madhyamas" "${pkgdir}/usr/bin/madhyamas"

    # Install web assets
    install -dm755 "${pkgdir}/usr/share/madhyamas/web"
    cp -r web/dist/* "${pkgdir}/usr/share/madhyamas/web/"

    # Install systemd service
    install -Dm644 "${srcdir}/madhyamas.service" "${pkgdir}/usr/lib/systemd/system/madhyamas.service"

    # Install default config
    install -Dm644 "config/default.toml" "${pkgdir}/etc/madhyamas/config.toml" || true

    # Install licenses
    install -Dm644 "LICENSE-MIT" "${pkgdir}/usr/share/licenses/${pkgname}/MIT"
    install -Dm644 "LICENSE-APACHE" "${pkgdir}/usr/share/licenses/${pkgname}/Apache-2.0"

    # Install shell completions
    install -dm755 "${pkgdir}/usr/share/bash-completion/completions"
    install -dm755 "${pkgdir}/usr/share/zsh/site-functions"
    install -dm755 "${pkgdir}/usr/share/fish/vendor_completions.d"

    "${pkgdir}/usr/bin/madhyamas" completion --shell bash > "${pkgdir}/usr/share/bash-completion/completions/madhyamas" || true
    "${pkgdir}/usr/bin/madhyamas" completion --shell zsh > "${pkgdir}/usr/share/zsh/site-functions/_madhyamas" || true
    "${pkgdir}/usr/bin/madhyamas" completion --shell fish > "${pkgdir}/usr/share/fish/vendor_completions.d/madhyamas.fish" || true
}
