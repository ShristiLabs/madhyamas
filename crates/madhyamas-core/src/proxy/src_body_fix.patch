+
+// Custom serializer for Vec<u8> -> String (for JSON output)
+pub fn serialize_u8_to_string<S>(bytes: &Option<Vec<u8>>, serializer: S) -> Result<S::Ok, S::Error>
+where
+    S: serde::Serializer,
+{
+    match bytes {
+        Some(b) => {
+            // Try to convert to UTF-8 string, fallback to base64 for binary data
+            match String::from_utf8(std::str::from_utf8_lossy(b)) {
+                Ok(s) => serializer.serialize_str(&s),
+                Err(_) => {
+                    use base64::{engine::general_purpose::STANDARD, Engine};
+                    let encoded = base64::encode(b);
+                    serializer.serialize_str(&encoded)
+                }
+            }
+        }
+        None => serializer.serialize_none(),
+    }
+}
+
+// Custom deserializer for String -> Vec<u8>
+pub fn deserialize_string_to_u8<'de, D>(s: Option<String>, deserializer: D) -> Result<Option<Vec<u8>>, D::Error>
+where
+    D: serde::Deserializer<'de>,
+{
+    match s {
+        Some(str) => {
+            // Try base64 decode first, if it fails assume UTF-8
+            match base64_decode(&str) {
+                Some(bytes) => Ok(Some(bytes)),
+                None => Ok(Some(str.as_bytes().to_vec())),
+            }
+        }
+        None => Ok(None),
+    }
+}
+
+fn base64_decode(s: &str) -> Option<Vec<u8>> {
+    use base64::{engine::general_purpose::STANDARD, Engine};
+    base64::decode(s).ok()
+}
