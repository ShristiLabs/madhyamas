# Madhyamas demo stack environment — copy to .env and fill in.
#   cp .env.example .env && chmod 600 .env

# Fine-grained GitHub PAT with Contents:read on ShristiLabs/licensing.
# Only needed for the FULL in-repo Docker build path (README.md appendix);
# the default path uses the workflow-built binary and needs no token here.
LICENSING_TOKEN=

# JWT signing secret for auth. Generate:  openssl rand -base64 48
MADHYAMAS_JWT_SECRET=

# First-run bootstrap admin account (created only when the users table
# is empty; changing these later does not change the password).
MADHYAMAS_ADMIN_USERNAME=admin
MADHYAMAS_ADMIN_PASSWORD=

# Host encoded into the `madhyamas://connect` pairing QR.
# Start with the LAN IP (e.g. 10.0.0.152), switch to the public proxy
# hostname (madhyamas-proxy.shristilabs.com) once DNS + TLS are live.
MADHYAMAS_PUBLIC_IP=

# --- Public VPS (Hetzner) overlay -------------------------------------
# Merge the Caddy overlay (web UI HTTPS + TLS proxy listener):
# COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml
# Certbot (certbot-proxy.sh) account + ACME agreement:
# CERTBOT_EMAIL=you@example.com
# MADHYAMAS_PROXY_DOMAIN=madhyamas-proxy.shristilabs.com
